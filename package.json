{
  "name": "jev-harness-router",
  "version": "1.1.2",
  "description": "Per-turn harness router: one Jev call picks the model tier, tools, skill and effort budget for an agent turn.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "agent",
    "harness",
    "router",
    "model-routing",
    "llm",
    "typesafe",
    "jev",
    "claude",
    "agent-sdk",
    "skills",
    "tool-selection",
    "claude-agent-sdk"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "route": "tsx bin/route.ts",
    "chat": "tsx bin/chat.ts",
    "calibrate": "tsx bin/calibrate.ts",
    "eval": "tsx bin/eval.ts",
    "bench": "tsx bin/bench.ts",
    "savings": "tsx bin/savings.ts",
    "example:agent-sdk": "tsx examples/agent-sdk.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src bin test examples",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@types/node": "22.20.3",
    "oxlint": "1.19.0",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoacoMarc/jev-harness-router.git"
  },
  "homepage": "https://github.com/JoacoMarc/jev-harness-router#readme",
  "bugs": {
    "url": "https://github.com/JoacoMarc/jev-harness-router/issues"
  }
}
