{
  "name": "jev-harness-router",
  "version": "1.0.0",
  "description": "Per-turn harness router: one Jev call picks the model tier, tools, skill and effort budget for an agent turn.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "route": "tsx bin/route.ts",
    "chat": "tsx bin/chat.ts",
    "calibrate": "tsx bin/calibrate.ts",
    "eval": "tsx bin/eval.ts",
    "bench": "tsx bin/bench.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src bin test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "oxlint": "1.19.0",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoacoMarc/jev-harness-router.git"
  }
}
