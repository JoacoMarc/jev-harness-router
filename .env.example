# Server-side only. Never ship this to a browser, and never put a real key in this file —
# this one is committed. The real key goes in .env, which .gitignore keeps out of git.
# Get a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=your-key-here

# Pinned on purpose: confidence thresholds are calibrated against one model version,
# and the `jev-latest` alias moves on every release.
TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# Only needed by `npm run chat`, which runs the routed turn on a real model.
# Change provider in src/catalog/provider.ts — it lists Anthropic, OpenAI, Groq,
# OpenRouter, Ollama and anything else that speaks one of those two wire formats,
# then set whichever key that provider wants here.
ANTHROPIC_API_KEY=your-key-here
